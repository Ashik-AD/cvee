#!/bin/sh

COMMIT_MSG_FILE=$1

# Ignore automatic merge commit messages.
if grep -Eq ' into |^Merge ' "$COMMIT_MSG_FILE"; then
    exit 0
fi

# Read only the first line of the commit message.
IFS= read -r COMMIT_MSG < "$COMMIT_MSG_FILE" || :

CONVENTIONS_PREFIXES="feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert"

# Conventional Commits regex.
CONVENTIONAL_COMMIT_REGEX="^(${CONVENTIONS_PREFIXES})(\([a-zA-Z0-9_.-]+\))?(!)?:[[:space:]].+"

# Validate the commit message.
if ! printf '%s\n' "$COMMIT_MSG" | grep -Eq "$CONVENTIONAL_COMMIT_REGEX"; then
    echo "ERROR: Commit message does not follow Conventional Commits format."
    echo
    echo "Expected format:"
    echo "  <type>(<optional scope>): <description>"
    echo
    echo "Valid types: [$CONVENTIONS_PREFIXES]"
    echo
    echo "Examples:"
    echo "  feat(auth): add login functionality"
    echo "  fix(api)!: resolve timeout issue"
    echo "  docs(readme): update installation instructions"
    exit 1
fi

exit 0
